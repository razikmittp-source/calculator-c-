// CoreC — Arrays and loops
fn sum_array(arr: [i32], size: i32) -> i32 {
    let mut total = 0
    for i in [0..size] {
        total += arr[i]
    }
    return total
}

fn main() {
    let nums = [10, 20, 30, 40, 50]
    let total = sum_array(nums, 5)
    print("Array: [10, 20, 30, 40, 50]")
    print("Sum = {total}")

    // For-in loop
    let mut max = 0
    for n in nums {
        if n > max {
            max = n
        }
    }
    print("Max = {max}")
}
