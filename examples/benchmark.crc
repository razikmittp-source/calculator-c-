// CoreC — Benchmark: sum of primes
fn is_prime(n: i32) -> bool {
    if n < 2 {
        return false
    }
    let mut i = 2
    while i * i <= n {
        if n % i == 0 {
            return false
        }
        i += 1
    }
    return true
}

fn main() {
    let mut count = 0
    let mut sum = 0
    for n in [2..100000] {
        if is_prime(n) {
            count += 1
            sum += n
        }
    }
    print("Primes under 100000: {count}")
    print("Sum of primes: {sum}")
}
